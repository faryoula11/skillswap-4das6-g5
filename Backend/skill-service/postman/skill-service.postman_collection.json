{
  "info": {
    "_postman_id": "skillswap-skill-service-collection-v1",
    "name": "SkillSwap — MS2 skill-service & Infra (Amal Jemli)",
    "description": "Collection Postman complète pour tester skill-service (Catégories, Compétences, UserSkills, Soft-Delete, OpenFeign, Sécurité RBAC, Actuator) ainsi qu'Eureka Server et Config Server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8082" },
    { "key": "eurekaUrl", "value": "http://localhost:8761" },
    { "key": "configUrl", "value": "http://localhost:8888" },
    { "key": "userId", "value": "user-amal-1" },
    { "key": "adminRoles", "value": "USER,ADMIN" }
  ],
  "item": [
    {
      "name": "1. Catégories (/api/categories)",
      "item": [
        {
          "name": "GET Lister toutes les catégories (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "GET Catégorie par ID (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories/1"
          }
        },
        {
          "name": "POST Créer une catégorie (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "{{adminRoles}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cloud & DevOps\",\n  \"description\": \"Docker, Kubernetes, CI/CD et déploiement cloud\"\n}"
            },
            "url": "{{baseUrl}}/api/categories"
          }
        },
        {
          "name": "POST Créer catégorie sans rôle ADMIN (Attendu: 403 RFC 7807)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "USER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Interdit\",\n  \"description\": \"Doit retourner 403 Forbidden\"\n}"
            },
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "2. Catalogue Compétences (/api/skills)",
      "item": [
        {
          "name": "GET Catalogue paginé (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills?page=0&size=10"
          }
        },
        {
          "name": "GET Rechercher par mot-clé q=Spring (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills?q=Spring"
          }
        },
        {
          "name": "GET Filtrer par catégorie (categoryId=1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills?categoryId=1"
          }
        },
        {
          "name": "GET Compétence par ID (Public)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/skills/1"
          }
        },
        {
          "name": "POST Ajouter une compétence au catalogue (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "{{adminRoles}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Docker Compose\",\n  \"description\": \"Orchestration locale de conteneurs\",\n  \"categoryId\": 1\n}"
            },
            "url": "{{baseUrl}}/api/skills"
          }
        },
        {
          "name": "GET Statistiques globales (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "{{adminRoles}}" }
            ],
            "url": "{{baseUrl}}/api/skills/stats"
          }
        }
      ]
    },
    {
      "name": "3. Compétences Membres (/api/user-skills)",
      "item": [
        {
          "name": "POST Déclarer une compétence OFFERED (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "USER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillId\": 1,\n  \"type\": \"OFFERED\",\n  \"level\": \"EXPERT\",\n  \"description\": \"Accompagnement pratique sur Spring Boot et microservices\"\n}"
            },
            "url": "{{baseUrl}}/api/user-skills"
          }
        },
        {
          "name": "GET Mes compétences (/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "USER" }
            ],
            "url": "{{baseUrl}}/api/user-skills/me"
          }
        },
        {
          "name": "GET Vérifier une compétence par ID (Contrat OpenFeign exchange-service)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-skills/1"
          }
        },
        {
          "name": "GET Qui enseigne la compétence 1 ? (Recherche paginée)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-skills?skillId=1&type=OFFERED&page=0&size=10"
          }
        },
        {
          "name": "PUT Modifier niveau/description (Propriétaire)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "USER" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillId\": 1,\n  \"type\": \"OFFERED\",\n  \"level\": \"INTERMEDIATE\",\n  \"description\": \"Sessions de 1h sur les API REST Spring Boot\"\n}"
            },
            "url": "{{baseUrl}}/api/user-skills/1"
          }
        },
        {
          "name": "DELETE Soft Delete (204 No Content -> active=false)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "X-User-Roles", "value": "USER" }
            ],
            "url": "{{baseUrl}}/api/user-skills/1"
          }
        },
        {
          "name": "GET Vérifier après Soft Delete (Attendu: active=false)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/user-skills/1"
          }
        }
      ]
    },
    {
      "name": "4. Observabilité Actuator (Atelier Part 2)",
      "item": [
        {
          "name": "GET /actuator/health (db MySQL + skillCatalog)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health"
          }
        },
        {
          "name": "GET /actuator/info",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/info"
          }
        },
        {
          "name": "GET /actuator/metrics",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/metrics"
          }
        },
        {
          "name": "GET /actuator/metrics/http.server.requests",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/actuator/metrics/http.server.requests"
          }
        }
      ]
    },
    {
      "name": "5. Infrastructure (Eureka & Config Server)",
      "item": [
        {
          "name": "GET Eureka — Applications enregistrées",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{eurekaUrl}}/eureka/apps"
          }
        },
        {
          "name": "GET Config Server — skill-service/default",
          "request": {
            "method": "GET",
            "url": "{{configUrl}}/skill-service/default"
          }
        },
        {
          "name": "GET Config Server — api-gateway/default",
          "request": {
            "method": "GET",
            "url": "{{configUrl}}/api-gateway/default"
          }
        }
      ]
    }
  ]
}
